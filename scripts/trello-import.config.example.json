  "listRules": [
    { "match": "wzór rozpisania", "target": "skip" },
    { "match": "plany i raporty", "target": "skip" },
    { "match": "raporty tygodniowe", "target": "skip" },

    { "match": "opisy i oszacowania", "target": "property", "status_dluznika": "analiza" },
    { "match": "sukces", "target": "property", "status_dluznika": "umowa" },

    { "match": "ródła tematów - zarządcy", "target": "kontakt", "typ": "zarzadca" },
    { "match": "ródła tematów - komornicy", "target": "kontakt", "typ": "komornik" },
    { "match": "ródła tematów - windykacje", "target": "kontakt", "typ": "zarzadca" },
    { "match": "ródła tematów - pośrednicy", "target": "kontakt", "typ": "zarzadca" },
    { "match": "ródła tematów - posrednicy", "target": "kontakt", "typ": "zarzadca" },
    { "match": "ródła tematów - licytacje", "target": "lead", "temperature": "warm" },
    { "match": "ródła tematów", "target": "kontakt", "typ": "zarzadca" },

    { "match": "spółdzielnie/ wspólnoty", "target": "kontakt", "typ": "spoldzielnia" },
    { "match": "spółdzielnie", "target": "kontakt", "typ": "spoldzielnia" },
    { "match": "wspólnoty", "target": "kontakt", "typ": "wspolnota" },
    { "match": "komornicy/pośrednicy", "target": "kontakt", "typ": "komornik" },
    { "match": "komornicy", "target": "kontakt", "typ": "komornik" },
    { "match": "pośrednicy", "target": "kontakt", "typ": "zarzadca" },

    { "match": "licytacje", "target": "lead", "temperature": "warm" },
    { "match": "internet", "target": "lead", "temperature": "warm" },
    { "match": "inne", "target": "lead", "temperature": "cold" },

    { "match": "odrzucone", "target": "lead", "status": "rejected", "temperature": "cold" },
    { "match": "niezainteresowany", "target": "lead", "status": "rejected", "temperature": "cold" }
  ],

  "labels": {
    "Pilne": { "lead_temperature": "hot" },
    "gotowe w teren": { "lead_temperature": "hot" },
    "brak aktywności ": { "lead_temperature": "cold" },
    "Niezainteresowani": { "lead_temperature": "cold" },
    "NIEZAINTERESOWANI": { "lead_temperature": "cold" }
  }
