generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  full_name  String
  avatar_url String?
  role       String   @default("user")
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  properties_created     Property[]         @relation("PropertyCreator")
  properties_assigned    Property[]         @relation("PropertyAssignee")
  tasks_created          Task[]             @relation("TaskCreator")
  tasks_assigned         Task[]             @relation("TaskAssignee")
  activity_logs          ActivityLog[]
  wall_messages          WallMessage[]
  wall_reads             WallRead[]
  task_comments          TaskComment[]
  notifications_received Notification[]     @relation("NotificationRecipient")
  notifications_sent     Notification[]     @relation("NotificationSender")
  managed_by             TeamVisibility[]   @relation("TeamManager")
  member_of              TeamVisibility[]   @relation("TeamMember")
  team_rules_created     TeamVisibility[]   @relation("TeamRuleCreator")
  kontakty_created       Kontakt[]          @relation("KontaktCreator")
  kontakty_assigned      Kontakt[]          @relation("KontaktAssignee")
  kontakt_komentarze     KontaktKomentarz[]

  @@map("profiles")
}

model Property {
  id                String   @id @default(uuid()) @db.Uuid
  location          String
  trello_link       String?
  phone             String?
  contact_type      String?
  property_type     String?
  area_sqm          Decimal? @db.Decimal(10, 2)
  value_per_sqm     Decimal? @db.Decimal(14, 2)
  total_debt        Decimal  @default(0) @db.Decimal(14, 2)
  debt_type         String?
  creditor1_amount  Decimal  @default(0) @db.Decimal(14, 2)
  creditor2_amount  Decimal  @default(0) @db.Decimal(14, 2)
  creditor3_amount  Decimal  @default(0) @db.Decimal(14, 2)
  owner_coefficient Decimal  @default(0.025) @db.Decimal(6, 4)
  commission_pct    Decimal  @default(0) @db.Decimal(6, 4)
  notary_fee        Decimal  @default(1000) @db.Decimal(10, 2)
  manual_offer      Decimal? @db.Decimal(14, 2)
  status            String   @default("new")
  decision          String?
  notes             String?
  created_by        String?  @db.Uuid
  assigned_to       String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz()
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz()

  creator       Profile?      @relation("PropertyCreator", fields: [created_by], references: [id])
  assignee      Profile?      @relation("PropertyAssignee", fields: [assigned_to], references: [id])
  tasks         Task[]
  activity_logs ActivityLog[]
  documents     Document[]

  @@index([status])
  @@index([assigned_to])
  @@index([created_at(sort: Desc)])
  @@map("properties")
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  property_id  String?   @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  due_date     DateTime? @db.Date
  assigned_to  String?   @db.Uuid
  created_by   String?   @db.Uuid
  completed_at DateTime? @db.Timestamptz()
  created_at   DateTime  @default(now()) @db.Timestamptz()
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz()

  property      Property?     @relation(fields: [property_id], references: [id], onDelete: Cascade)
  assignee      Profile?      @relation("TaskAssignee", fields: [assigned_to], references: [id])
  creator       Profile?      @relation("TaskCreator", fields: [created_by], references: [id])
  comments      TaskComment[]
  activity_logs ActivityLog[]

  @@index([property_id])
  @@index([assigned_to])
  @@index([status])
  @@map("tasks")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  property_id String?  @db.Uuid
  task_id     String?  @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  details     Json?
  created_at  DateTime @default(now()) @db.Timestamptz()

  property Property? @relation(fields: [property_id], references: [id], onDelete: Cascade)
  task     Task?     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user     Profile?  @relation(fields: [user_id], references: [id])

  @@index([property_id])
  @@index([created_at(sort: Desc)])
  @@map("activity_log")
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  property_id String   @db.Uuid
  name        String
  file_url    String
  file_type   String?
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz()

  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("documents")
}

model WallMessage {
  id         String     @id @default(uuid()) @db.Uuid
  user_id    String?    @db.Uuid
  content    String
  pinned     Boolean    @default(false)
  created_at DateTime   @default(now()) @db.Timestamptz()

  user  Profile?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  reads WallRead[]

  @@index([created_at(sort: Desc)])
  @@map("wall_messages")
}

model WallRead {
  user_id    String   @db.Uuid
  message_id String   @db.Uuid
  read_at    DateTime @default(now()) @db.Timestamptz()

  user    Profile     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  message WallMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@id([user_id, message_id])
  @@index([user_id])
  @@map("wall_reads")
}

model TeamVisibility {
  id         String   @id @default(uuid()) @db.Uuid
  manager_id String   @db.Uuid
  member_id  String   @db.Uuid
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz()

  manager Profile  @relation("TeamManager", fields: [manager_id], references: [id], onDelete: Cascade)
  member  Profile  @relation("TeamMember", fields: [member_id], references: [id], onDelete: Cascade)
  creator Profile? @relation("TeamRuleCreator", fields: [created_by], references: [id])

  @@unique([manager_id, member_id])
  @@index([manager_id])
  @@index([member_id])
  @@map("team_visibility")
}

model TaskComment {
  id         String   @id @default(uuid()) @db.Uuid
  task_id    String   @db.Uuid
  user_id    String?  @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  task Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([created_at(sort: Desc)])
  @@map("task_comments")
}

model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  from_user_id String?  @db.Uuid
  type         String
  title        String
  body         String?
  link         String?
  reference_id String?  @db.Uuid
  read         Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz()

  user      Profile  @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  from_user Profile? @relation("NotificationSender", fields: [from_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, read, created_at(sort: Desc)])
  @@map("notifications")
}

model Kontakt {
  id                             String   @id @default(uuid()) @db.Uuid
  // typ: spoldzielnia | wspolnota_zarzadca | posrednik_nieruchomosci | posrednik_finansowy
  //       kancelaria_spadkowa | kancelaria_rozwodowa | notariusz | rzeczoznawca
  typ                            String
  nazwa                          String
  wojewodztwo                    String?
  miasto                         String?
  ulica                          String?
  godziny_otwarcia               String?
  telefon                        String?
  email                          String?
  opis                           String?
  assigned_to                    String?  @db.Uuid
  oddzial                        String?
  created_by                     String?  @db.Uuid

  // Pola zależne od typu: spółdzielnia / wspólnota
  liczba_budynkow                Int?
  liczba_mieszkan                Int?

  // Statusy realizacji
  wizyta_osobista                Boolean  @default(false)
  wyslany_mail_oferta            Boolean  @default(false)

  // Statusy wykonawcze (część wspólna + specyficzne dla spółdzielni/wspólnoty)
  zgoda_ulotki                   Boolean  @default(false)
  zgoda_plakat                   Boolean  @default(false)
  chec_wspolpracy                Boolean  @default(false)
  niezainteresowani              Boolean  @default(false)
  operator_budowy_zainteresowani Boolean  @default(false)

  // Pola przy chęci współpracy (pośrednicy/kancelarie/notariusz/rzeczoznawca)
  ustalona_prowizja              String?
  umowa_url                      String?

  lat                            Float?
  lng                            Float?

  created_at                     DateTime @default(now()) @db.Timestamptz()
  updated_at                     DateTime @default(now()) @updatedAt @db.Timestamptz()

  assignee   Profile?          @relation("KontaktAssignee", fields: [assigned_to], references: [id])
  creator    Profile?          @relation("KontaktCreator", fields: [created_by], references: [id])
  komentarze KontaktKomentarz[]

  @@index([typ])
  @@index([assigned_to])
  @@index([created_at(sort: Desc)])
  @@map("kontakty")
}

model KontaktKomentarz {
  id         String   @id @default(uuid()) @db.Uuid
  kontakt_id String   @db.Uuid
  user_id    String?  @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz()

  kontakt Kontakt  @relation(fields: [kontakt_id], references: [id], onDelete: Cascade)
  user    Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([kontakt_id])
  @@index([created_at(sort: Desc)])
  @@map("kontakt_komentarze")
}

model ResearchQuery {
  id          String   @id @default(uuid()) @db.Uuid
  property_id String?  @db.Uuid
  person_name String
  kw_number   String?
  notes       String?
  status      String   @default("pending")
  results     Json?
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@index([person_name])
  @@index([created_at(sort: Desc)])
  @@map("research_queries")
}
