# --- Supabase (aplikacja) ---
# Lokalne wartości wypisuje `supabase start`; produkcyjne: Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — TYLKO serwer (operacje na kontach, skrypty). Nigdy nie wystawiaj do przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Migracja danych (jednorazowo, skrypty w scripts/) ---
# Stara baza (Prisma/NextAuth):
OLD_DATABASE_URL=postgresql://user:pass@host:5432/limona
# Bezpośrednie połączenie z Postgresem projektu Supabase (rola postgres):
SUPABASE_DB_URL=postgresql://postgres:pass@db.your-project-ref.supabase.co:5432/postgres

# --- Integracje wyszukiwarki (opcjonalne, jak dotychczas) ---
CEIDG_API_TOKEN=
GOOGLE_API_KEY=
GOOGLE_CX=

# --- Google Drive (zakładka Dokumenty: foldery per lead/nieruchomość/kontakt) ---
#
# WARIANT A — OAuth (zalecany; działa też na zwykłym koncie @gmail.com):
# 1. Google Cloud: projekt → włącz "Google Drive API".
# 2. APIs & Services → OAuth consent screen: typ External, uzupełnij nazwę,
#    dodaj siebie jako test usera LUB opublikuj (Publish app).
# 3. Credentials → Create credentials → OAuth client ID → Web application →
#    w "Authorized redirect URIs" dodaj: https://<domena-crm>/api/drive/oauth/callback
# 4. Wklej niżej Client ID i Client secret, zrestartuj aplikację,
#    a potem w CRM: panel Admin → Integracje → "Połącz z Google Drive".
# Pliki należą do połączonego konta; folder "Limona CRM" tworzy się sam.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcjonalnie, gdy aplikacja stoi za proxy i origin nie zgadza się z domeną:
GOOGLE_OAUTH_REDIRECT_URL=
#
# WARIANT B — konto serwisowe (Workspace + Dysk współdzielony lub delegacja):
# 1. Google Cloud: włącz "Google Drive API" → utwórz konto serwisowe → klucz JSON.
# 2. Na Dysku utwórz folder-korzeń CRM i udostępnij go e-mailowi konta serwisowego (Edytujący).
# 3. Wklej niżej: client_email i private_key z JSON-a oraz ID folderu z URL Dysku.
# Uwaga: konto serwisowe nie ma własnej quoty — upload z CRM wymaga Dysku
# współdzielonego ALBO delegacji domenowej (GOOGLE_DRIVE_IMPERSONATE_USER).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key z JSON-a — w jednej linii, z \n jako "\n" (albo prawdziwe nowe linie w cudzysłowie)
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Delegacja domenowa (Workspace, admin: Bezpieczeństwo → Dostęp do API →
# Delegowanie w całej domenie → Client ID konta serwisowego z zakresem
# https://www.googleapis.com/auth/drive) + mail, w imieniu którego działa integracja:
GOOGLE_DRIVE_IMPERSONATE_USER=
#
# Gdy ustawione są oba warianty, pierwszeństwo ma OAuth.

# --- Endpointy cronowe (etap 4) ---
CRON_SECRET=

# --- Webhook leadów (n8n, formularze) ---
# POST /api/webhooks/leads z nagłówkiem `Authorization: Bearer <sekret>`
# albo `X-Webhook-Secret: <sekret>`. Wygeneruj długi losowy string.
LEADS_WEBHOOK_SECRET=

# --- Import z Trello (scripts/import-trello.ts) ---
# Klucz: https://trello.com/power-ups/admin → New → API key → wygeneruj token.
# Bez klucza import traci większość komentarzy (eksport JSON obcina akcje
# do 1000) i nie pobierze plików załączników.
TRELLO_KEY=
TRELLO_TOKEN=
# AI do układania danych z opisów/komentarzy w pola CRM (adres, KW, metraż,
# zadłużenie, dłużnik...). Klucz: https://aistudio.google.com/apikey
# Podgląd jakości przed importem: --ai-sample 10 (na sucho).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
